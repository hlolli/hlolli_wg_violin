if(NOT DEFINED CONFIG)
  set(CONFIG "@_hlolli_chaconne_default_config@")
endif()
if(NOT CONFIG MATCHES "^[A-Za-z0-9_-]*$")
  message(FATAL_ERROR "CONFIG contains an invalid character")
endif()
set(_worker "${CMAKE_CURRENT_LIST_DIR}/play_bach_chaconne-${CONFIG}.cmake")
if(NOT EXISTS "${_worker}")
  message(FATAL_ERROR "No Chaconne player exists for CONFIG=${CONFIG}")
endif()
include("${_worker}")
